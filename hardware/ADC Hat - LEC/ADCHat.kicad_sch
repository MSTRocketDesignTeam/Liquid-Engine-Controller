		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "00a6701c-5796-4c77-b968-b5ec1b70c3bc")
	)
	(text_box "in case we want to put 5V into the 3.3V regulator to reduce heat losses or just general heat profile, since having a Vo-Vi will reduce heat."
