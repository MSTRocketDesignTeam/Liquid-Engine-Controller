	(text_box "10MHz external clock with a series resonance, meaning it doesn't need load capacitors. 10MHz is over the 7.68MHz standard clock, so we are effectively overclocking to ~40kSPS"
		(exclude_from_sim no)
		(at 25.4 171.45 0)
		(size 29.21 16.51)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
