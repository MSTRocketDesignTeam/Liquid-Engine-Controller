	(text "https://www.digikey.com/en/products/filter/led-indication-discrete/105?s=N4IgjCBcpgbFoDGUBmBDANgZwKYBoQB7KAbRAGYBOAJgBZ4BdAgBwBcoQBlVgJwEsAdgHMQAXwLkA7AhDJI6bPiKkKAVjC0w1EBPVhVADh0ha1cuTMgmINh279hYgqtrkZchbgLFIZOgdVKIwJqAAYwyjdrW0guXkERcRAAWm1oWSheAFclHzJVK1EioA"
